# Google Maps JavaScript API
# Restrict this key by HTTP referrer (website) and enable only Maps JavaScript API.
VITE_GOOGLE_MAPS_API_KEY=

# Optional but recommended: Cloud-based Map ID (controls white-land / blue-water / labels styling).
# The map will still load without this; cloud styling requires a Map ID.
# Do not add a local Google Maps styles array — the Map ID owns styling.
VITE_GOOGLE_MAP_ID=
