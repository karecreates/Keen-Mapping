{
  "name": "colorado-data-visualization",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare-data": "node scripts/prepare-map-data.mjs --all",
    "fetch-geometry": "node scripts/fetch-zctas.mjs --all",
    "fetch-geometry:force": "node scripts/fetch-zctas.mjs --all --force",
    "prepare-map": "npm run prepare-data && npm run fetch-geometry",
    "dev": "vite",
    "build": "npm run prepare-data && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.65.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
